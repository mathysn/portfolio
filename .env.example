# URL publique du site (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulaire de contact — sans RESEND_API_KEY, les messages sont seulement loggés en console.
RESEND_API_KEY=
# Destinataire des messages (par défaut : l'email de src/lib/site.ts)
CONTACT_TO_EMAIL=
# Expéditeur vérifié dans Resend
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
